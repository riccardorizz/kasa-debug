# Tapo account (used only for local control of the bulb)
TAPO_USER=your-tapo-account@example.com
TAPO_PASS=your-password

# Local IP of the bulb (set a DHCP reservation on your router)
BULB_IP=192.168.1.100

# Optional: Matter pairing code, shown in the app. Keep it private, never commit it.
MATTER_CODE=

# Optional: comma-separated allowed origins (default: *)
# CORS_ORIGINS=http://192.168.1.50:8081
